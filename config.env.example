# Audiobooks Project - Development Configuration (template)
# =========================================================
# Copy to config.env (gitignored) to use library/launch-v2.sh:
#   cp config.env.example config.env
#
# DEVELOPMENT ONLY. EVERY path the application reads is pinned below, inside
# the project working tree, so nothing falls through to a code default that
# points at the installed application (/var/lib/audiobooks, /srv/audiobooks,
# /opt/audiobooks). The launcher also sets AUDIOBOOKS_SKIP_SYSTEM_CONFIG so
# /etc/audiobooks and ~/.config/audiobooks are never read, and refuses to
# start if any path variable resolves into an installed-application tree.
# If you add a path setting to library/config.py, pin it here too.
#
# The launcher exports PROJECT_DIR (the directory holding this file) before
# reading it; set PROJECT_DIR yourself if you source this file elsewhere.
# Environment variables set before launch override the values below.
# Never put credentials in this file.

AUDIOBOOKS_HOME="${PROJECT_DIR}"
AUDIOBOOKS_PROJECT_DIR="${PROJECT_DIR}"

# Test data (synthetic, inside the project)
AUDIOBOOKS_DATA="${PROJECT_DIR}/library/testdata"
AUDIOBOOKS_LIBRARY="${PROJECT_DIR}/library/testdata/Library"
AUDIOBOOKS_SOURCES="${PROJECT_DIR}/library/testdata/Sources"
AUDIOBOOKS_SUPPLEMENTS="${PROJECT_DIR}/library/testdata/Supplements"
AUDIOBOOKS_LOGS="${PROJECT_DIR}/library/testdata/logs"
AUDIOBOOKS_WEBM_CACHE="${PROJECT_DIR}/.dev-state/webm-cache"
DATA_DIR="${PROJECT_DIR}/library/data"
AUDIOBOOK_DIR="${PROJECT_DIR}/library/testdata/Library"
SUPPLEMENTS_DIR="${PROJECT_DIR}/library/testdata/Supplements"

# Writable dev state (gitignored directory)
AUDIOBOOKS_VAR_DIR="${PROJECT_DIR}/.dev-state"
AUDIOBOOKS_RUN_DIR="${PROJECT_DIR}/.dev-state/run"
AUDIOBOOKS_STAGING="${PROJECT_DIR}/.dev-state/staging"
AUDIOBOOKS_STREAMING_AUDIO_DIR="${PROJECT_DIR}/.dev-state/streaming-audio"
AUDIOBOOKS_STREAMING_SUBTITLES_DIR="${PROJECT_DIR}/.dev-state/streaming-subtitles"

# Databases and covers
AUDIOBOOKS_DATABASE="${PROJECT_DIR}/library/backend/audiobooks-dev.db"
DATABASE_PATH="${PROJECT_DIR}/library/backend/audiobooks-dev.db"
AUTH_DATABASE="${PROJECT_DIR}/.dev-state/auth.db"
AUTH_DB_PATH="${PROJECT_DIR}/.dev-state/auth.db"
AUDIOBOOKS_COVERS="${PROJECT_DIR}/library/web-v2/covers"
COVER_DIR="${PROJECT_DIR}/library/web-v2/covers"

# Tooling inside the working tree
AUDIOBOOKS_CERTS="${PROJECT_DIR}/library/certs"
AUDIOBOOKS_VENV="${PROJECT_DIR}/library/venv"
AUDIOBOOKS_CONVERTER="${PROJECT_DIR}/converter/AAXtoMP3"

# Development ports (installed application: API 5001, web 8443)
AUDIOBOOKS_WEB_PORT=9090
AUDIOBOOKS_API_PORT=6001

# Development flags
AUDIOBOOKS_DEV_MODE="true"
AUDIOBOOKS_HTTPS_ENABLED="false"
AUDIOBOOKS_HTTP_REDIRECT_ENABLED="false"
