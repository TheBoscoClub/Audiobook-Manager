exclude_dirs:
  - .snapshots
  - .btrbk-snapshots
  - venv
  - node_modules
  - .git

# Global skips — every listed test ID has been analyzed and the finding is
# acceptable for this codebase. These are NOT bulk dismissals; each rule
# below has an explicit justification and every corresponding use-site was
# reviewed during the 2026-04-17 audit.
#
# WHY THESE ARE GLOBAL AND NOT INLINE `# nosec`
# --------------------------------------------
# Under bandit 1.9.4 the inline `# nosec` comments scattered through this
# codebase are largely INERT. bandit matches a `# nosec` to the line number it
# reports the issue on, and for the multi-line call expressions this project
# uses it reports the SQL/URL literal line rather than the `conn.execute(` /
# `urlopen(` line the comment sits on. The annotations are therefore best read
# as review notes for humans, not as working suppressions — do not assume a
# `# nosec` on a line means bandit is quiet about it, and do not delete a
# global skip on the belief that the inline comments are covering it.
#
# COMPENSATING CONTROL FOR THE B608 SKIP
# --------------------------------------
# A global skip means a NEW dangerous site can never be flagged, so B608 has a
# replacement signal: `library/tests/test_source_guards.py` parses the tree and
# fails if any interpolated SQL f-string lacks a `# nosec B608` annotation.
# That test is what makes adding one a deliberate, reviewable act. If the B608
# skip is ever removed, that guard becomes redundant — until then it is the
# only thing watching.
skips:
  # B101 (assert_used) — 19 findings in api_modular.
  # All uses are TYPE-NARROWING invariants after decorator-guaranteed
  # preconditions (e.g. `user = require_current_user(); assert user is not
  # None` after @login_required). Purpose is static type refinement for
  # mypy, not runtime validation. If the assert fired, the decorator
  # contract was already broken and would have 401'd before reaching the
  # route. Safe to strip under `-O`.
  - B101
  # B404 (import_subprocess) — 12 findings. subprocess is REQUIRED to
  # invoke ffmpeg, ffprobe, git, systemctl, and other CLI tools the
  # project wraps. There is no alternative.
  - B404
  # B603 (subprocess_without_shell_equals_true) — 16 findings. Every
  # flagged call uses a FIXED argument list (no shell, no user-input
  # interpolation). The `shell=False` default is in effect; Bandit flags
  # the call on principle even when safely configured.
  - B603
  # B607 (start_process_with_partial_path) — 13 findings. The project
  # intentionally locates CLI tools via $PATH so it works across distros
  # where ffmpeg/ffprobe live at /usr/bin, /usr/local/bin,
  # /opt/homebrew/bin, etc. A hardcoded absolute path would break
  # portability. Risk is bounded because installed-app $PATH is
  # controlled by the systemd unit environment, not user input.
  - B607
  # B608 (hardcoded_sql_expressions) — 22 findings across api_modular/,
  # scanner/utils/, scripts/, and backend/migrations/. Every flagged site
  # follows the same verified-safe pattern: table/column names are
  # hardcoded string literals or chosen from an allowlist (e.g.
  # ALLOWED_LOOKUP_TABLES in scanner/utils/db_helpers.py), and every
  # user-controlled value is bound through a `?` parameter placeholder.
  # The f-string only interpolates internal constants. Every call-site
  # already carries `# nosec B608` and `# nosemgrep: ...` annotations,
  # but bandit 1.9.4 reports the issue on the SQL-literal line rather
  # than the `conn.execute(` line, so inline suppressions do not cover
  # the flagged line number. Global skip is the correct mechanism here
  # because the pattern is uniform across the codebase. Any NEW f-string
  # SQL construction must be verified parameterized before bypassing
  # this skip.
  - B608
  # B108 (hardcoded_tmp_directory) — 4 findings, all in
  # library/tests/test_batch_translate.py. These are argparse test
  # strings passed to `_parse_args()` for argument parsing validation;
  # no file is ever created or read from `/tmp/x.db` or `/tmp/lib`.
  # The corresponding ruff S108 is suppressed for library/tests/**
  # in pyproject.toml. Bandit should match that policy.
  - B108
  # B105 (hardcoded_password_string) — LOW severity, ~36 findings, all
  # in library/tests/** plus one sentinel status value in auth_admin.py
  # (annotated `# nosec B105`). Every flagged string is a test fixture:
  # synthetic usernames, fake claim tokens, SMTP test credentials,
  # route strings mistaken as passwords by bandit heuristics. Ruff
  # already suppresses S105/S106 for library/tests/** in pyproject.toml
  # with documented rationale. Bandit should match.
  - B105

assert_used:
  skips:
    - '*/test_*.py'
    - '*/tests/*.py'
    - '*/conftest.py'
