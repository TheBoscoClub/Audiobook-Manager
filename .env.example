# Audiobooks - Environment Configuration Template
#
# SCOPE: this file documents the DOCKER COMPOSE quick-start only.
#
#   `.env` is read by docker-compose for `${VAR}` interpolation in
#   docker-compose.yml — nothing else. It is gitignored, and in this
#   repository it is intentionally empty: the compose file supplies a default
#   for every variable it interpolates, so `docker compose up` works without
#   one. A native (non-Docker) installation is configured through
#   /etc/audiobooks/audiobooks.conf, NOT through this file; the AUDIOBOOKS_*
#   entries below are documented here for reference only and setting them in
#   .env has no effect on a native install.
#
#   Every variable docker-compose.yml interpolates MUST appear in this file.
#   The compose file's default is the fallback, so an undocumented variable is
#   invisible: nothing errors, the default is simply silently in force.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your paths
#   docker-compose up -d

# =============================================================================
# REQUIRED: Path to your audiobook files
# =============================================================================
AUDIOBOOK_DIR=/path/to/your/audiobooks

# =============================================================================
# OPTIONAL: Core paths
# =============================================================================
# Base installation directory
# AUDIOBOOKS_HOME=/opt/audiobooks

# Base data directory for all audiobook data
# AUDIOBOOKS_DATA=/srv/audiobooks

# Library directory (converted audiobooks)
# AUDIOBOOKS_LIBRARY=/srv/audiobooks/Library

# Sources directory (original AAX/AAXC files)
# AUDIOBOOKS_SOURCES=/srv/audiobooks/Sources

# Supplements directory (PDFs, course materials, maps, etc.)
# SUPPLEMENTS_DIR=/path/to/supplements

# Database file location
# AUDIOBOOKS_DATABASE=/opt/audiobooks/library/backend/audiobooks.db

# Cover art directory
# AUDIOBOOKS_COVERS=/opt/audiobooks/library/web-v2/covers

# SSL certificates directory
# AUDIOBOOKS_CERTS=/opt/audiobooks/library/certs

# Log files directory
# AUDIOBOOKS_LOGS=/srv/audiobooks/logs

# Python virtual environment
# AUDIOBOOKS_VENV=/opt/audiobooks/library/venv

# AAXtoMP3 converter location
# AUDIOBOOKS_CONVERTER=/opt/audiobooks/converter/AAXtoMP3

# =============================================================================
# OPTIONAL: Port configuration
# =============================================================================
# HTTPS web interface port (default: 8443)
WEB_PORT=8443

# HTTP redirect port (redirects to HTTPS, default: 8080)
# HTTP_PORT=8080

# Backend API port (default: 5001)
# AUDIOBOOKS_API_PORT=5001

# =============================================================================
# OPTIONAL: Server configuration
# =============================================================================
# Bind address (default: 0.0.0.0)
# AUDIOBOOKS_BIND_ADDRESS=0.0.0.0

# Enable HTTPS (default: true)
# AUDIOBOOKS_HTTPS_ENABLED=true

# WSGI server: Gunicorn+geventwebsocket (migrated from Waitress in v7.2)
# No configuration needed — started via systemd/Docker with correct worker class

# Enable HTTP to HTTPS redirect
# HTTP_REDIRECT_ENABLED=true  # Deprecated alias — use canonical name below
AUDIOBOOKS_HTTP_REDIRECT_ENABLED=true

# HTTP redirect port (default: 8080)
# AUDIOBOOKS_HTTP_REDIRECT_PORT=8080

# =============================================================================
# OPTIONAL: Container instance badge (docker-compose only)
# =============================================================================
# Short label rendered as a pulsing pill in the web shell header, to tell
# stacks apart during testing (e.g. STAGING, QA, QA-NATIVE, QA-DOCK).
# Leave unset for production — an empty value renders no pill.
# INSTANCE_BADGE=

# =============================================================================
# OPTIONAL: Authentication settings
# =============================================================================
# Enable authentication (default: false for standalone mode)
# AUTH_ENABLED=false

# Auth paths INSIDE the container. docker-compose.yml sets these to the
# /app/auth volume and they are not `${}`-interpolated, so overriding them in
# .env does nothing — edit docker-compose.yml instead. Named here because the
# container variables differ from the native ones (AUTH_DB_PATH below):
#   AUTH_DATABASE=/app/auth/auth.db
#   AUTH_KEY_FILE=/app/auth/auth.key

# Path to the authentication key file (64 hex chars)
# AUTH_KEY_FILE=/etc/audiobooks/auth.key

# Path to the authentication database (SQLCipher encrypted)
# AUTH_DB_PATH=/var/lib/audiobooks/auth.db

# WebAuthn origin for passkey authentication (must match the URL users access)
# WEBAUTHN_ORIGIN=https://your-server:8443

# CORS origin for cross-origin requests (default: * for localhost)
# CORS_ORIGIN=*

# =============================================================================
# OPTIONAL: Development settings
# =============================================================================
# Uncomment for development mode
# FLASK_ENV=development
# FLASK_DEBUG=1
