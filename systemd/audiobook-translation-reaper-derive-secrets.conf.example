# Drop-in TEMPLATE for audiobook-translation-reaper.service — Vast.ai credential
# ==============================================================================
# NOT a unit. install.sh / upgrade.sh copy this file to
# /etc/systemd/system/audiobook-translation-reaper.service.d/derive-secrets.conf
# ONLY when /usr/bin/derive-service-secret exists on the host. Same mechanism as
# audiobook-translation-drain-derive-secrets.conf.example (read that header).
#
# The reaper needs the key to LIST and DESTROY abm-drain instances; it never
# rents. derive-service-secret fails closed when VAST_API_KEY is missing from
# the store, which fails the unit (an alert, not silence) — on a host with the
# tool but no Vast account, remove this drop-in.
#
# Hosts without derive-service-secret: set VAST_API_KEY_FILE in
# /etc/audiobooks/audiobooks.conf (the same file the drain uses). With no
# credential configured at all the reaper exits 0: nothing can have been rented.

[Service]
ExecStartPre=+/usr/bin/derive-service-secret VAST_API_KEY /run/audiobook-translation-reaper/vast-api-key audiobooks
Environment=VAST_API_KEY_FILE=/run/audiobook-translation-reaper/vast-api-key
