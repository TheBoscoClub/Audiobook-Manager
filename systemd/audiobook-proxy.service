[Unit]
Description=Audiobooks Library HTTPS Reverse Proxy
Documentation=https://github.com/TheBoscoClub/Audiobook-Manager
After=network-online.target audiobook-api.service
Wants=network-online.target audiobook-api.service
# PartOf ensures proxy restarts when API restarts (Requires only stops it)
PartOf=audiobook-api.service
# Ensure /opt BTRFS subvolume is mounted before starting (prevents intermittent CHDIR failures)
RequiresMountsFor=/opt/audiobooks
# Generous interval allows time for API (and its RAID dependency) to come up
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=audiobooks
Group=audiobooks
WorkingDirectory=/opt/audiobooks/library/web-v2

# Load configuration from /etc/audiobooks/audiobooks.conf
EnvironmentFile=/etc/audiobooks/audiobooks.conf
Environment=PYTHONUNBUFFERED=1

# Only start if port is not already in use
ExecStartPre=/bin/sh -c '! /usr/bin/ss -tlnp | /usr/bin/grep -q ":${AUDIOBOOKS_WEB_PORT} "'
# Gunicorn with gevent workers (v8.4.2.0, Option B — mirrors audiobook-api.service).
# All server settings (bind, TLS + TLS1.2 floor, worker count, timeouts) live in
# gunicorn_proxy.conf.py — the single canonical configuration source. Unlike the
# API's 1-worker WebSocket-state constraint, the proxy is stateless; worker count
# defaults to 2 (override with AUDIOBOOKS_PROXY_WORKERS in audiobooks.conf).
ExecStart=/opt/audiobooks/library/venv/bin/gunicorn \
    -c /opt/audiobooks/library/web-v2/gunicorn_proxy.conf.py \
    proxy_server:app

Restart=on-failure
RestartSec=30
LimitNOFILE=65536
# Use journal logging (query with: journalctl -u audiobook-proxy)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audiobook-proxy

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/audiobooks /opt/audiobooks
# Data directory for audiobooks database and cache
ReadWritePaths=/var/lib/audiobooks
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=audiobook.target multi-user.target
