[Unit]
Description=Audiobook translation drain — daily (ships disabled; operator opt-in)
Documentation=https://github.com/TheBoscoClub/Audiobook-Manager
PartOf=audiobook.target

[Timer]
# Daily batching window: books acquired during the day share one node rental.
# Off by default — enable with:
#   sudo systemctl enable --now audiobook-translation-drain.timer
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=1h
Persistent=true
Unit=audiobook-translation-drain.service

[Install]
WantedBy=timers.target
