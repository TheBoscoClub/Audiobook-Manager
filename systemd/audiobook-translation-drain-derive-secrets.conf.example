# Drop-in TEMPLATE for audiobook-translation-drain.service — Vast.ai credential
# ==============================================================================
# NOT a unit. install.sh / upgrade.sh copy this file to
# /etc/systemd/system/audiobook-translation-drain.service.d/derive-secrets.conf
# ONLY when /usr/bin/derive-service-secret exists on the host. Same mechanism as
# audiobook-api-derive-secrets.conf.example — read that file for the details.
#
# At every service start the "+" line runs as root, reads exactly ONE variable
# (VAST_API_KEY) from the operator's canonical store and writes it to the
# unit's private RuntimeDirectory as a 0400 file owned by audiobooks. The
# directory is removed when the run ends, so the key exists on disk only while
# a drain is running, and rotation needs no redeploy.
#
# scripts/translation-drain.sh never reads the value: it passes the pointer
# below to gpu-node.sh / gpu-budget-guard.sh, which load the file into a 0600
# curl config. derive-service-secret fails closed (the run fails, nothing is
# rented) when the variable is missing or empty in the store.
#
# Hosts without derive-service-secret: set VAST_API_KEY_FILE in
# /etc/audiobooks/audiobooks.conf to a 0600 audiobooks-owned file instead.

[Service]
ExecStartPre=+/usr/bin/derive-service-secret VAST_API_KEY /run/audiobook-translation-drain/vast-api-key audiobooks
Environment=VAST_API_KEY_FILE=/run/audiobook-translation-drain/vast-api-key
