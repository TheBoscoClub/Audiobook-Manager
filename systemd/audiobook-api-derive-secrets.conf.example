# Drop-in TEMPLATE for audiobook-api.service — derive-service-secret integration
# ==============================================================================
# NOT installed automatically as a unit. install.sh / upgrade.sh copy this file
# to /etc/systemd/system/audiobook-api.service.d/derive-secrets.conf ONLY when
# /usr/bin/derive-service-secret exists on the target host; on hosts without the
# tool the install proceeds without it and nothing changes.
#
# Mechanism
# ---------
# derive-service-secret is operator tooling — its canonical source lives OUTSIDE
# this project (the operator's cloudflare-manager tooling ships and tests it).
# Each ExecStartPre=+ line below runs as root (the "+" prefix escapes the unit's
# User=audiobooks sandbox), reads exactly ONE named variable from the operator's
# canonical credential store, and writes its value to /run/audiobooks/<name> as
# a 0400 file owned by the named service user (third argument). Because
# RuntimeDirectory=audiobooks in the stock unit is wiped and recreated by
# systemd at every service start, the secrets are re-derived on every start —
# a hand-copied credential file can never drift from the canonical store.
#
# The application's own contract is unchanged
# -------------------------------------------
# The app only knows the *_FILE pointer pattern (e.g. SMTP_PASS/SMTP_PASS_FILE,
# CLOUDFLARE_PURGE_TOKEN_FILE) resolved via
# library/common_utils/secret_resolver.py. The stock unit works WITHOUT this
# drop-in: the pointers then target the operator-populated 0600 stub files under
# /etc/audiobooks/ created by install.sh / upgrade.sh. This drop-in only changes
# WHERE the pointer targets get their content.
#
# Activation
# ----------
# After this drop-in is installed, repoint the *_FILE variables in
# /etc/audiobooks/audiobooks.conf at the /run paths and daemon-reload:
#   CLOUDFLARE_PURGE_TOKEN_FILE=/run/audiobooks/cloudflare-purge-token
#   SMTP_PASS_FILE=/run/audiobooks/smtp-pass
# The store variable names below (CF_TOKEN_CACHE_PURGE, RESEND_KEY_LIBRARY)
# are the operator's canonical entry names — adjust them if your store names
# differ. derive-service-secret fails closed (service does not start) when the
# named variable is missing or empty.

[Service]
ExecStartPre=+/usr/bin/derive-service-secret CF_TOKEN_CACHE_PURGE /run/audiobooks/cloudflare-purge-token audiobooks
ExecStartPre=+/usr/bin/derive-service-secret RESEND_KEY_LIBRARY /run/audiobooks/smtp-pass audiobooks
