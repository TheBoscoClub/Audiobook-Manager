# Audiobook Library Configuration
# ================================
# Copy this file to one of these locations:
#   System-wide: /etc/audiobooks/audiobooks.conf
#   User-only:   ~/.config/audiobooks/audiobooks.conf
#
# Permissions: if you put credentials (SMTP_PASS, tokens) in this file it must not
# be world-readable. System install: root:audiobooks mode 0640; user install:
# mode 0600. install.sh creates it that way and upgrade.sh enforces it.
#
# Environment variables override these settings.
# Values are read in this order (later overrides earlier):
#   1. Built-in defaults
#   2. /etc/audiobooks/audiobooks.conf (system)
#   3. ~/.config/audiobooks/audiobooks.conf (user)
#   4. Environment variables
#   5. Command-line arguments

# =============================================================================
# Core Directories
# =============================================================================

# IMPORTANT: Path keys below are commented out — they document the defaults
# only. Uncomment and edit a line ONLY if you need to override that specific
# default. Hardcoding defaults in this file causes drift the next time the
# canonical defaults change in library/config.py and lib/audiobook-config.sh.

# NOTE ON ${VAR} REFERENCES: systemd's EnvironmentFile= does NOT expand
# ${...} — a service started from this file receives the text literally. The
# application expands references itself (library/config.py and
# lib/audiobook-config.sh resolve ${NAME} / $NAME against other settings and
# the environment, and refuse to start on an undefined variable or a cycle),
# so the templates below are safe to uncomment. Do not rely on them in a unit
# file's own Environment=/ExecStart= lines, where systemd will not expand them
# either. upgrade.sh rewrites any such line in the installed config to its
# concrete value (backup beside the file) so what is on disk says what it means.
# Use concrete paths if another tool also reads this file.

# Root directory containing all audiobook data (sources, library, supplements)
# Default: /srv/audiobooks (system) or ~/Audiobooks (user)
# AUDIOBOOKS_DATA="/srv/audiobooks"

# Converted audiobook files organized by Author/Title
# Default: ${AUDIOBOOKS_DATA}/Library
# AUDIOBOOKS_LIBRARY="${AUDIOBOOKS_DATA}/Library"

# Original source files (AAXC, vouchers, metadata)
# Default: ${AUDIOBOOKS_DATA}/Sources
# AUDIOBOOKS_SOURCES="${AUDIOBOOKS_DATA}/Sources"

# PDF supplements and companion materials
# Default: ${AUDIOBOOKS_DATA}/Supplements
# AUDIOBOOKS_SUPPLEMENTS="${AUDIOBOOKS_DATA}/Supplements"

# =============================================================================
# Application Directories
# =============================================================================

# Project installation directory (contains scripts, web UI, etc.)
# Default: /opt/audiobooks (system) or detected from script location
# AUDIOBOOKS_HOME="/opt/audiobooks"

# Database file location
# Default: /var/lib/audiobooks/db/audiobooks.db
# AUDIOBOOKS_DATABASE="/var/lib/audiobooks/db/audiobooks.db"

# Cover art cache directory
# Default: /var/lib/audiobooks/covers
# AUDIOBOOKS_COVERS="/var/lib/audiobooks/covers"

# Runtime directory for locks and FIFOs (scheduler, WebSocket)
# Default: /var/lib/audiobooks/.run
# AUDIOBOOKS_RUN_DIR="/var/lib/audiobooks/.run"

# SSL certificate directory (for HTTPS)
# Default: ${AUDIOBOOKS_HOME}/library/certs
# AUDIOBOOKS_CERTS="${AUDIOBOOKS_HOME}/library/certs"

# Caddy static dir (maintenance.html, unavailable.html, upgrade-status.json).
# Read by install.sh, upgrade.sh and upgrade-helper-process so Caddy's root and
# the upgrade-status mirror always agree.
# Default: /etc/caddy
# AUDIOBOOKS_CADDY_DIR="/etc/caddy"

# WebM cache directory (for browser-compatible audio streams)
# Default: ${AUDIOBOOKS_DATA}/.webm-cache
# AUDIOBOOKS_WEBM_CACHE="${AUDIOBOOKS_DATA}/.webm-cache"

# Log file directory
# Default: ${AUDIOBOOKS_DATA}/logs
# AUDIOBOOKS_LOGS="${AUDIOBOOKS_DATA}/logs"

# =============================================================================
# Server Configuration
# =============================================================================

# API server port
# Default: 5001
AUDIOBOOKS_API_PORT = "5001"

# Web server port (HTTPS) - changed from 8090 to 8443
# Default: 8443
AUDIOBOOKS_WEB_PORT = "8443"

# Bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# Default: 0.0.0.0
AUDIOBOOKS_BIND_ADDRESS = "0.0.0.0"

# HTTP to HTTPS redirect port
# Default: 8080
AUDIOBOOKS_HTTP_REDIRECT_PORT = "8080"

# WSGI server: Gunicorn with the gevent worker (migrated from Waitress in v7.2;
# audiobook-proxy migrated from a ThreadingHTTPServer to Gunicorn+gevent in v8.4.2.0).
# No further configuration needed — Gunicorn is started via systemd with the
# correct worker class for each service.

# Reverse-proxy Gunicorn worker count (audiobook-proxy only; the proxy is
# stateless so this can scale). The API is pinned to 1 worker for its
# in-memory WebSocket connection manager and is not configurable here.
# Default: 2
# AUDIOBOOKS_PROXY_WORKERS="2"

# =============================================================================
# Optional Features
# =============================================================================

# Enable HTTPS for web server (requires certificate)
# Default: true
AUDIOBOOKS_HTTPS_ENABLED = "true"

# Python virtual environment path (for API server)
# Default: ${AUDIOBOOKS_HOME}/library/venv
# AUDIOBOOKS_VENV="${AUDIOBOOKS_HOME}/library/venv"

# AAXtoMP3 converter location
# Default: ${AUDIOBOOKS_HOME}/converter/AAXtoMP3
# AUDIOBOOKS_CONVERTER="${AUDIOBOOKS_HOME}/converter/AAXtoMP3"

# =============================================================================
# Authentication (Multi-user Support)
# =============================================================================

# Enable authentication for remote access
# When enabled, users must log in to access the library
# When disabled (default), admin endpoints are restricted to localhost
# Default: false (standalone mode, no auth required)
AUTH_ENABLED = "false"

# Authentication database path (SQLCipher encrypted)
# Default: /var/lib/audiobooks/auth.db
# AUTH_DATABASE="/var/lib/audiobooks/auth.db"

# Encryption key file for auth database
# IMPORTANT: This file must be readable only by the audiobooks user (chmod 600)
# Default: /etc/audiobooks/auth.key
# AUTH_KEY_FILE="/etc/audiobooks/auth.key"

# Development mode for auth (relaxed key permissions, verbose logging)
# Default: false
AUDIOBOOKS_DEV_MODE = "false"

# =============================================================================
# Remote Access (only needed when AUTH_ENABLED="true")
# =============================================================================
# These settings are for exposing the library over the internet.
# You can use any reverse proxy (Caddy, nginx, Traefik) and any DNS/tunnel
# provider (Cloudflare, DuckDNS, Tailscale, WireGuard, etc.)

# Your public domain or hostname (used for WebAuthn and email links)
# Examples: library.example.com, audiobooks.myserver.net
# Default: auto-detected from request (works for localhost without config)
# AUDIOBOOKS_HOSTNAME=""

# Base URL for email links (magic links, invitations)
# Example: https://library.example.com
# Default: auto-detected from request
# BASE_URL=""

# Cloudflare CDN cache purge (optional)
# Set your Cloudflare zone ID to enable automatic cache purging after upgrades.
# Find it in the Cloudflare dashboard: zone overview → API → Zone ID
# CF_ZONE_ID=""

# Cloudflare authentication for cache purge. Use a SCOPED API TOKEN — create it
# with permission `Zone > Cache Purge > Purge`, restricted to this zone only.
# Sent as an `Authorization: Bearer` header.
#
# Preferred (hosts with derive-service-secret): the token is derived from the
# host's canonical credential store into /run/audiobooks at every service
# start, so it cannot drift from a rotation. install.sh/upgrade.sh install the
# drop-in systemd/audiobook-api-derive-secrets.conf.example automatically when
# /usr/bin/derive-service-secret exists; then point:
# CLOUDFLARE_PURGE_TOKEN_FILE="/run/audiobooks/cloudflare-purge-token"
#
# Fallback (no derive-service-secret): a 0600 audiobooks-owned file under
# /etc/audiobooks. A hand-made copy does NOT follow a rotation in the
# Cloudflare console — re-copy it after every rotation (a stale copy silently
# broke purge for months: Audiobook-Manager-e7x).
# CLOUDFLARE_PURGE_TOKEN_FILE="/etc/audiobooks/cloudflare-purge-token"
#
# Precedence: inline CLOUDFLARE_PURGE_TOKEN → CLOUDFLARE_PURGE_TOKEN_FILE → empty.
# CLOUDFLARE_PURGE_TOKEN=""
#
# The legacy Global API Key path (CF_GLOBAL_API_KEY / CF_AUTH_EMAIL via
# CF_TOKEN_FILE) was removed in v8.4.3 and is no longer read.

# CORS allowed origin (restricts which domains can make API requests)
# Set this to your public URL for security when exposed to the internet
# Example: https://library.example.com
# Default: * (permissive, safe for standalone/localhost)
# CORS_ORIGIN=""

# WebAuthn/Passkey configuration (auto-derived from AUDIOBOOKS_HOSTNAME)
# Only set these if you need to override the auto-detection
# WEBAUTHN_RP_ID=""          # Relying Party ID (usually your domain)
# WEBAUTHN_RP_NAME=""        # Display name (default: "The Library")
# WEBAUTHN_ORIGIN=""         # Expected origin (default: https://{AUDIOBOOKS_HOSTNAME})

# =============================================================================
# Email / SMTP (only needed for invitation and recovery emails)
# =============================================================================

# SMTP server for sending emails (magic links, invitations, notifications)
# Leave unconfigured if you don't need email — admin can share claim tokens manually
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM is REQUIRED for any outbound mail and has no default. The relay
# selects its upstream credential by envelope sender, so an unset or
# @localhost sender is rejected upstream at MAIL FROM *after* local
# submission returned 250 OK — a silent hard bounce. Every send site now
# refuses to send rather than bounce under an unmapped identity.
SMTP_FROM = "library@example.com"

# Alternative: store the password in a separate 0600 file instead of inline.
# When SMTP_PASS_FILE is set, AM reads the password from that file. If both
# SMTP_PASS and SMTP_PASS_FILE are set, the inline value wins. Mirrors the
# existing AUTH_KEY_FILE / CLOUDFLARE_PURGE_TOKEN_FILE pattern.
# SMTP_PASS_FILE="/etc/audiobooks/smtp-pass"

# Operator alert recipient — receives translation-monitor escalations
# (chapter-starvation alerts, aged streaming segments). Falls back to
# SMTP_FROM when unset, so a configured SMTP block alone is enough to
# get monitor alerts to the same address that sends invitation emails.
# ADMIN_EMAIL=""

# =============================================================================
# Instance Identification
# =============================================================================

# Badge label shown in the web UI header (e.g., "QA", "DEV", "TEST")
# Helps distinguish non-production environments at a glance
# Leave empty or unset for production (no badge shown)
# INSTANCE_BADGE=""

# =============================================================================
# Development / Upgrade
# =============================================================================

# Path to the local development project directory for "From Project Directory"
# upgrades. When set, the upgrade UI pre-populates this path and auto-discovers
# the project. Only used by admins upgrading from a local source checkout.
# Example: /home/youruser/projects/Audiobook-Manager
# AUDIOBOOKS_PROJECT_DIR=""

# =============================================================================
# Performance & Advanced Settings
# =============================================================================

# Number of parallel conversion jobs
# Default: number of CPU cores
AUDIOBOOKS_PARALLEL_JOBS = "8"

# Data directory for scan results and intermediate files
# Default: /var/lib/audiobooks/data
# DATA_DIR="/var/lib/audiobooks/data"

# Index directory for checksum files (duplicates detection)
# NOTE: Currently unused — reserved for future implementation
# AUDIOBOOKS_INDEX="/var/lib/audiobooks/db/.index"

# =============================================================================
# Localization — TTS, STT, Translation
# =============================================================================

# TTS provider for on-demand translated audio narration.
# Options:
#   edge-tts       — Microsoft Edge TTS (default, free, CPU, English+Chinese)
#   xtts-runpod    — Coqui XTTS v2 on RunPod serverless (GPU, voice cloning)
# AUDIOBOOKS_TTS_PROVIDER="edge-tts"
# AUDIOBOOKS_TTS_VOICE_ZH="zh-CN-XiaoxiaoNeural"

# Machine-translation backend (burst sessions only — set while a GPU
# node from scripts/gpu-node.sh is up and tunnelled; unset otherwise)
# AUDIOBOOKS_MT_ENDPOINT="http://localhost:8000"
# AUDIOBOOKS_MT_MODEL="Qwen/Qwen3-8B"

# RunPod credentials (for xtts-runpod and STT Whisper)
# AUDIOBOOKS_RUNPOD_API_KEY=""
# AUDIOBOOKS_RUNPOD_XTTS_ENDPOINT=""
# AUDIOBOOKS_RUNPOD_WHISPER_ENDPOINT=""

# Self-hosted / rented GPU Whisper service (STT "local-gpu"). Default is
# plain http://HOST:PORT with no auth (e.g. via an SSH tunnel). For a
# TLS-fronted endpoint set the full base URL (overrides HOST/PORT) and,
# if the endpoint requires it, a bearer credential (or a *_FILE pointer).
# AUDIOBOOKS_WHISPER_GPU_HOST=""
# AUDIOBOOKS_WHISPER_GPU_PORT="8765"
# AUDIOBOOKS_WHISPER_GPU_URL="https://whisper.example.com"
# AUDIOBOOKS_WHISPER_GPU_TOKEN="<your-token>"
# AUDIOBOOKS_WHISPER_GPU_TOKEN_FILE="/etc/audiobooks/whisper-gpu-token"

# Scheduled translation drain (audiobook-translation-drain.timer — installed
# DISABLED; enabling it is an operator decision, see
# docs/MULTI-LANGUAGE-SETUP.md "Scheduled drain"). Each run that finds
# pending translation_queue rows rents a Vast.ai GPU node, runs
# batch-translate.py over the queue and destroys the node.
# AUDIOBOOKS_DRAIN_BUDGET_USD="10"             # hard spend cap per run (dollars)
# AUDIOBOOKS_DRAIN_MONTHLY_BUDGET_USD="100"    # ceiling per calendar month (local time)
# AUDIOBOOKS_DRAIN_MIN_RUN_USD="1"             # do not rent with less than this left this month
# AUDIOBOOKS_DRAIN_MAX_MINUTES="240"           # wall-clock limit, GPU subtitle batch
# AUDIOBOOKS_DRAIN_NARRATION_MAX_MINUTES="120" # wall-clock limit, host narration (edge-tts)
# AUDIOBOOKS_DRAIN_BOOTSTRAP_TIMEOUT="1800"    # seconds to wait for vLLM + whisper
# AUDIOBOOKS_DRAIN_LABEL="abm-drain-myhost"    # default abm-drain-<short hostname>; must be abm-drain-<name>
# AUDIOBOOKS_DRAIN_MAX_ATTEMPTS="3"            # failed runs before a book is quarantined
# AUDIOBOOKS_DRAIN_MAX_SUSPECT="3"             # runs losing the node with the same book in flight
# AUDIOBOOKS_DRAIN_REAPER_MARGIN_MINUTES="30"  # reaper slack past the longest legitimate run
# AUDIOBOOKS_DRAIN_LEDGER=""                   # spend ledger (default under AUDIOBOOKS_VAR_DIR)
# GPU_NODE_SSH_KEY=""                        # ssh identity registered at console.vast.ai -> Keys
# GPU_NODE_MAX_PRICE="2.50"                  # max dollars/hr for the offer
# VAST_API_KEY_FILE=""                       # only without derive-service-secret (0600, audiobooks-owned)

# =============================================================================
# Credential file alternatives (optional pointer-pattern variants)
# =============================================================================
# Credentials may be set inline (above) or stored in a separate 0600 file
# referenced by `*_FILE` env vars. The file-pointer variant keeps secrets
# out of the main config and works well with symlinks to user-level
# credential stores. Precedence: inline env var → *_FILE pointer → empty.
# Mirrors the existing AUTH_KEY_FILE / CLOUDFLARE_PURGE_TOKEN_FILE pattern.
# AUDIOBOOKS_RUNPOD_API_KEY_FILE="/etc/audiobooks/runpod-api-key"
