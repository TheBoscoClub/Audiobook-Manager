#!/bin/bash
# Pre-commit hook: Block hardcoded paths in audiobooks project
#
# This hook prevents commits that ADD hardcoded paths which should use
# configuration variables from lib/audiobook-config.sh instead.
#
# Install with scripts/install-hooks.sh (the tracked copy is the canonical one).
#
# Scope: every staged text file except SKIP_PATHS below, judged on the lines the
# commit ADDS (git diff --cached -U0), so touching a file that already carries a
# legacy literal is not blocked - only introducing a new one is.

# No `set -e`: another tool may append its own block below this hook (see
# scripts/install-hooks.sh), and errexit would leak into that block. Failure is
# explicit: a violation (or any git error) calls exit 1; a clean pass falls off
# the end WITHOUT exiting, so an appended block still runs.

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Forbidden literals, each "extended-regex::variable to use instead".
# Every entry is iterated below; add a new path here and nothing else.
# shellcheck disable=SC2016  # the $VARs are text for the message, not expansions
FORBIDDEN_PATTERNS=(
    # Runtime paths ('/run/audiobooks-<x>' unit/socket names are not the run dir)
    '/run/audiobooks([^-]|$)::$AUDIOBOOKS_RUN_DIR'
    # Persistent state
    '/var/lib/audiobooks::$AUDIOBOOKS_VAR_DIR'
    # Data tree: use $AUDIOBOOKS_DATA, $AUDIOBOOKS_LIBRARY, $AUDIOBOOKS_SOURCES
    # (Python: config.AUDIOBOOKS_DATA / AUDIOBOOKS_LIBRARY / AUDIOBOOKS_SOURCES)
    '/srv/audiobooks::$AUDIOBOOKS_DATA / $AUDIOBOOKS_LIBRARY / $AUDIOBOOKS_SOURCES'
)

# Paths where literals are legitimate.
is_skipped() {
    local file="$1"
    case "$file" in
        # Files that DEFINE the defaults
        lib/audiobook-config.sh | library/config.py | etc/audiobooks.conf.example) return 0 ;;
        # This hook itself names the forbidden literals
        scripts/hooks/*) return 0 ;;
        # Prose documentation and issue-tracker data describe paths, they do not use them
        *.md | .beads/* | *.jsonl) return 0 ;;
        # Tests assert the default behaviour, so they spell the defaults out
        */tests/* | tests/*) return 0 ;;
        # systemd does not expand shell variables in unit files; literals are required
        systemd/*) return 0 ;;
        # Installers run before any configuration exists (bootstrap)
        install.sh | uninstall.sh) return 0 ;;
    esac
    return 1
}

# Every diff the hook runs ignores user config that could blind it: colour
# codes (color.ui=always), external diff drivers/textconv, and `-diff`
# attributes that turn a file into "Binary files differ" (--text).
git_diff() {
    git -c color.ui=never -c color.diff=never diff --cached --no-color \
        --no-ext-diff --no-textconv --text --no-renames "$@"
}

fail_closed() {
    echo -e "${RED}pre-commit: cannot inspect the staged changes ($1); refusing the commit${NC}" >&2
    return 1
}

check_hardcoded_paths() {
    local names_file file raw added entry regex variable matches
    names_file=$(mktemp) || {
        fail_closed "mktemp failed"
        return 1
    }
    # --no-renames: a renamed/copied file is reported as an added file, so its
    # new path's added lines are judged (R/C would otherwise be missed).
    if ! git_diff --name-only -z --diff-filter=ACMR >"$names_file"; then
        rm -f "$names_file"
        fail_closed "git diff --name-only failed"
        return 1
    fi
    local STAGED_FILES=()
    mapfile -d '' STAGED_FILES <"$names_file"
    rm -f "$names_file"

    local VIOLATIONS=""
    for file in "${STAGED_FILES[@]}"; do
        if is_skipped "$file"; then
            continue
        fi

        if ! raw=$(git_diff -U0 -- ":(literal)$file"); then
            fail_closed "git diff failed for $file"
            return 1
        fi

        # Added lines only: after the first hunk header, take '+' lines (the
        # '+++ b/file' header precedes any hunk so a real line starting '++'
        # is kept). Comment-only lines are dropped.
        added=$(printf '%s\n' "$raw" | awk '
            /^@@/ { inhunk = 1; next }
            inhunk && /^\+/ {
                line = substr($0, 2)
                if (line !~ /^[[:space:]]*(#|\/\/)/) print line
            }')

        if [[ -z "$added" ]]; then
            continue
        fi

        for entry in "${FORBIDDEN_PATTERNS[@]}"; do
            regex="${entry%%::*}"
            variable="${entry#*::}"
            matches=$(printf '%s\n' "$added" | grep -nE -- "$regex" || true)
            if [[ -n "$matches" ]]; then
                VIOLATIONS="$VIOLATIONS\n${YELLOW}$file${NC}: hardcoded path, use $variable\n$matches\n"
            fi
        done
    done

    if [[ -n "$VIOLATIONS" ]]; then
        echo -e "${RED}╔════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${RED}║  COMMIT BLOCKED: Hardcoded paths detected                      ║${NC}"
        echo -e "${RED}╚════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "The following files add hardcoded paths that should use"
        echo -e "configuration variables from lib/audiobook-config.sh:"
        echo ""
        echo -e "$VIOLATIONS"
        echo ""
        echo -e "To fix:"
        echo -e "  1. Replace hardcoded paths with the variable named above"
        echo -e "     (Python: import it from library/config.py)"
        echo -e "  2. If no variable exists, add one to lib/audiobook-config.sh"
        echo -e "  3. Stage your changes and commit again"
        echo ""
        echo -e "See .claude/rules/paths-and-separation.md for the list of variables."
        echo ""
        return 1
    fi
    return 0
}

check_hardcoded_paths || exit 1
# Deliberately no trailing `exit 0`: a block appended after this line (beads
# integration) must still run. Falling off the end exits 0 when nothing follows.
